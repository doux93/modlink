{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ModuLink Studio",
  "version": "0.1.0",
  "identifier": "com.cmiot.modulink-studio",
  "build": {
    "beforeDevCommand": "powershell -ExecutionPolicy Bypass -File scripts/ensure-vite-dev.ps1",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/clean-stale-resources.cjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ModuLink Studio — 模组智能调测工具",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["../data/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
